ENVIRONMENT=local

# Manual real-provider smoke gate; keep disabled unless running scripts/manual_provider_smoke.py intentionally.
RUN_REAL_PROVIDER_SMOKE=0

# LLM / OpenRouter
OPENROUTER_API_KEY=change_me
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=change_me
OPENROUTER_APP_TITLE=document-digitization-ai
OPENROUTER_HTTP_REFERER=

# LLM runtime policy
EXTRACTION_PROVIDER=fake
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_STRUCTURED_OUTPUTS_ENABLED=true
LLM_STRUCTURED_OUTPUTS_REQUIRE_PARAMETERS=false
LLM_PROVIDER_SCHEMA_MODE=compact

# Storage
DATABASE_URL=sqlite+aiosqlite:///./data/app.db
DATABASE_ECHO=false
STORAGE_DATA_DIR=./data
STORAGE_UPLOADS_DIR=./data/uploads
STORAGE_RESULTS_DIR=./data/results

# Media staging
MEDIA_STAGING_BACKEND=none
IMGBB_API_KEY=change_me
MEDIA_STAGING_TTL_SECONDS=3600
MEDIA_STAGING_EXPIRY_SAFETY_SECONDS=60
MEDIA_STAGING_VERIFY_DOWNLOAD=false
MEDIA_STAGING_STRICT_VERIFY=false

# Image diagnostics
IMAGE_DIAGNOSTICS_MAX_FILE_SIZE_BYTES=20971520
IMAGE_DIAGNOSTICS_HARD_MIN_WIDTH_PX=32
IMAGE_DIAGNOSTICS_HARD_MIN_HEIGHT_PX=32
IMAGE_DIAGNOSTICS_LOW_RESOLUTION_MIN_WIDTH_PX=800
IMAGE_DIAGNOSTICS_LOW_RESOLUTION_MIN_HEIGHT_PX=800
IMAGE_DIAGNOSTICS_LOW_CONTRAST_THRESHOLD=16.0
IMAGE_DIAGNOSTICS_TOO_DARK_BRIGHTNESS_THRESHOLD=35.0
IMAGE_DIAGNOSTICS_TOO_BRIGHT_BRIGHTNESS_THRESHOLD=220.0
